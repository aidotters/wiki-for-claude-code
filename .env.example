# LLM-Wiki for Claude Code: Phase 2-A
# Anthropic API キーは `WIKI_LLM_BACKEND=anthropic` の場合のみ必須。
# `WIKI_LLM_BACKEND=claude-code` の場合は不要（Claude Code Max プランの認証情報を使う）。
# 自動テストは StubLLMClient で動作するため、テスト実行時は不要。

ANTHROPIC_API_KEY=your_api_key_here

# LLM バックエンド切替（Phase 2-A / ADR-018）
# - stub (既定): 決定的スタブ。テスト・冪等性確認用
# - anthropic: Anthropic SDK 経由（従量課金）。ANTHROPIC_API_KEY が必須
# - claude-code: claude-agent-sdk 経由で Claude Code (Max プラン定額枠) を呼ぶ
#   前提: `claude` バイナリが PATH に存在し、`claude /login` で認証済みであること
#   ANTHROPIC_API_KEY は不要（参照されない）
WIKI_LLM_BACKEND=stub

# モデル指定（任意、既定: claude-sonnet-4-6）
# WIKI_LLM_MODEL=claude-sonnet-4-6

# 任意: HTTP 取得時の User-Agent 識別子
# WIKI_USER_AGENT=llm-wiki-for-claude-code/0.1 (https://github.com/your/repo)
