# LLM-Wiki for Claude Code: Phase 1
# Anthropic API キーは Phase 1 オーケストレーション（ingest/regenerate）で
# LLM 呼び出しが必要な場合に設定する。
# Phase 1 の自動テストでは LLM スタブで動作するため必須ではない。

ANTHROPIC_API_KEY=your_api_key_here

# 任意: HTTP 取得時の User-Agent 識別子
# WIKI_USER_AGENT=llm-wiki-for-claude-code/0.1 (https://github.com/your/repo)
